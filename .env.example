PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER/YOUR_DATABASE?retryWrites=true&w=majority
JWT_SECRET=local_development_secret_change_before_deployment_2026_only
JWT_EXPIRES_IN=1d
# Optional: add this to enable real OpenAI-powered rewriting. Without it, local draft generation still works.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
